                      "ioValue": "__GEOMETRY_INPUT__"
                    },
                    {
                      "name": "placements",
                      "ioValue": "12.55,18.42,180,F;-5.46,28.19,-90,F;-8.63,19.38,90,F;13.80,-46.80,90,B",
                      "currentEquation": "12.55,18.42,180,F;-5.46,28.19,-90,F;-8.63,19.38,90,F;13.80,-46.80,90,B"
                    },
                    {
                      "name": "boardThickness",
                      "ioValue": 1.8
                    }
                  ],
                  "interpreterVersion": 1,
                  "code": "/**\n * Pattern: places copies of one part at KiCad footprint positions.\n * placements = \"x,y,rotationDeg,side;...\" in board coordinates (mm).\n * side F puts the part on the top face; B flips it to hang under the board;\n * K keeps it exactly as modelled (already hanging under the board).\n */\nfunction run(\n  part: Assembly | undefined = undefined,\n  placements: string = \"0,0,0,F\",\n  boardThickness: number = 1.8,\n): Assembly {\n  if (!part) throw new Error(\"Connect the part to place\");\n  const copies = placements\n    .split(\";\")\n    .filter((s) => s.trim() !== \"\")\n    .map((s) => {\n      const [x, y, r, side] = s.split(\",\").map((v) => v.trim());\n      return (part as any).onLeafs((leaf: any) => {\n        let g = leaf.geometry.clone();\n        if (side === \"B\") g = g.rotate(180, [0, 0, 0], [1, 0, 0]);\n        g = g\n          .rotate(Number(r), [0, 0, 0], [0, 0, 1])\n          .translate(Number(x), Number(y), side === \"F\" ? boardThickness : 0);\n        return new Assembly({ ...leaf, geometry: g });\n      });\n    });\n  return new Assembly({ geometry: copies });\n}",
                  "compiledCode": "\"use strict\";\n/**\n * Pattern: places copies of one part at KiCad footprint positions.\n * placements = \"x,y,rotationDeg,side;...\" in board coordinates (mm).\n * side F puts the part on the top face; B flips it to hang under the board;\n * K keeps it exactly as modelled (already hanging under the board).\n */\nfunction run(part = undefined, placements = \"0,0,0,F\", boardThickness = 1.8) {\n    if (!part)\n        throw new Error(\"Connect the part to place\");\n    const copies = placements\n        .split(\";\")\n        .filter((s) => s.trim() !== \"\")\n        .map((s) => {\n        const [x, y, r, side] = s.split(\",\").map((v) => v.trim());\n        return part.onLeafs((leaf) => {\n            let g = leaf.geometry.clone();\n            if (side === \"B\")\n                g = g.rotate(180, [0, 0, 0], [1, 0, 0]);\n            g = g\n                .rotate(Number(r), [0, 0, 0], [0, 0, 1])\n                .translate(Number(x), Number(y), side === \"F\" ? boardThickness : 0);\n            return new Assembly({ ...leaf, geometry: g });\n        });\n    });\n    return new Assembly({ geometry: copies });\n}\n"
                },
